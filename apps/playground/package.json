		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.4",
		"@types/node": "^22.20.5",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.5.2",
